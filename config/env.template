# Plantilla de configuración de EDITIA.
# Copiar a .env en la raíz de la instalación (setup-vps.sh lo hace) y proteger:
#   cp config/env.template .env && chmod 600 .env
# Nunca subir .env al repositorio. Ver docs/MANUAL-INSTALACION-OPERACION-MANTENIMIENTO.md

# --- OJS (Open Journal Systems) --------------------------------------------
# Sin OJS_BASE_URL y OJS_API_KEY la pestaña OJS muestra "no configurado".
OJS_BASE_URL=https://revista.ejemplo.edu/ojs
OJS_API_KEY=
OJS_JOURNAL_PATH=index
# Secreto que OJS debe enviar en la cabecera x-ojs-signature al llamar a /api/webhooks/ojs.
# Si se deja vacío, el webhook acepta cualquier petición.
OJS_WEBHOOK_SECRET=

# --- Supabase (opcional; sin ellas la app funciona en modo demo) ------------
# Se incrustan en el código del navegador al construir la imagen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- URL pública -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://editorial.ejemplo.edu

# --- Métricas -----------------------------------------------------------------
# Token para /api/metrics. Defina uno propio y largo; el valor por defecto de
# docker-compose.yml es público.
METRICS_TOKEN=

# --- Grafana -----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=
GRAFANA_ROOT_URL=https://editorial.ejemplo.edu/grafana

# --- Copias de seguridad (solo scripts del servidor) -------------------------
# Cadena de conexión de Postgres de Supabase para que upgrade.sh haga pg_dump.
# No la ponga aquí si prefiere exportarla solo en la sesión de mantenimiento.
SUPABASE_DB_URL=
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PATH=
AWS_S3_BUCKET=
